module(name = "xla_mpi", version = "0.0.0")

bazel_dep(name = "xla")
git_override(
    module_name = "xla",
    remote = "https://github.com/openxla/xla.git",
    commit = "f0d71c5bbec3b308069c2c8f7abf2a43b8d25fd9",
)

bazel_dep(name = "rules_ml_toolchain")
archive_override(
    module_name = "rules_ml_toolchain",
    integrity = "sha256-izPVqzV2I7ox7EYzRzcRY6ogeLcHUr4LRP2xMrkWh6A=",
    strip_prefix = "rules_ml_toolchain-236a498d8624bef88e35ce2518a833204b0db19f",
    urls = ["https://github.com/google-ml-infra/rules_ml_toolchain/archive/236a498d8624bef88e35ce2518a833204b0db19f.tar.gz"],
)

# Vendored copy of xla/third_party/grpc/grpc.patch: bzlmod's
# single_version_override.patches only accepts patches from the root
# module's own repo, not a dependency's, so this can't just reference
# @xla's copy directly.
single_version_override(
    module_name = "grpc",
    patch_strip = 1,
    patches = ["//bazel/patches:grpc.patch"],
    version = "1.81.0",
)

bazel_dep(name = "abseil-cpp", version = "20260526.0", repo_name = "com_google_absl")

llvm = use_extension("@xla//third_party/extensions:llvm.bzl", "llvm_extension")
use_repo(llvm, "llvm-project")

tsl = use_extension("@xla//third_party/extensions:tsl.bzl", "tsl_extension")
use_repo(tsl, "tsl")

mpi = use_extension("//bazel:mpi_configure.bzl", "mpi_extension")
use_repo(mpi, "mpi")
